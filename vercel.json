{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/app.js", "destination": "/static/app.js" },
    { "source": "/style.css", "destination": "/static/style.css" },
    { "source": "/assets/:path*", "destination": "/static/assets/:path*" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/uploads/:path*", "destination": "/api/index.py" },
    { "source": "/download/:path*", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  }
}
